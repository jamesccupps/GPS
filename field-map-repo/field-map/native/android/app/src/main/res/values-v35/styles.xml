<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 15 (API 35) makes edge-to-edge mandatory for apps that target it: the
  window is laid out behind the system bars, so a WebView at bottom:0 puts its
  bottom ~48dp under the navigation/gesture strip, where the system consumes the
  touches. This app's whole control surface -- the drag grip, the five tabs and
  the buttons under them -- lives in that strip, which made the tray look present
  and completely dead on a Pixel running Android 16.

  Opting out is honoured for targetSdk 35 and ignored from 36, so this is a
  deliberate stopgap: the CSS now also pads for env(safe-area-inset-bottom), and
  when the target moves to 36 the insets carry it on their own.
-->
<resources>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
